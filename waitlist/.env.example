# Copy to /etc/lexari-waitlist/admin.env (root only). Never commit the real file.
PORT=3220
HOST=127.0.0.1
DB_PATH=/var/lib/lexari-waitlist/waitlist.db
PUBLIC_URL=https://waitlist.lexari.ai
# CSV export token for /admin/export.csv
ADMIN_TOKEN=
# Privy app id (public, same app as lexari.ai). Email OTP must be enabled and this origin allowed in the Privy dashboard.
PRIVY_APP_ID=
# Optional Privy client id for this origin
PRIVY_CLIENT_ID=
# Optional PEM verification key; fetched from Privy when empty
PRIVY_VERIFICATION_KEY=
# Optional tasks. A task only shows when its value is set.
X_HANDLE=
TELEGRAM_URL=
DISCORD_URL=
